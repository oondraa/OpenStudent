{
  "name": "openstudent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "data": "tsx scripts/transit.ts && tsx scripts/places.ts && tsx scripts/walk.ts",
    "pipeline": "cd pipeline && python -m openstudent run && python ../scripts/ingest.py"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/workers-types": "^5.20261012.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "jpeg-js": "^0.4.4",
    "opentype.js": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "web-push": "^3.6.7",
    "wrangler": "^4.149.0"
  },
  "description": "OpenŠtudent: rozvrh, obědy, volné učebny a SideQuesty pro studenty všech škol v Hradci Králové",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/oondraa/OpenStudent"
  }
}
