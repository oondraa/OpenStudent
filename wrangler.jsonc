{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openstudent",
  // Same Cloudflare account as OpenSISAKHK. Pinned so a wrangler login to another account cannot deploy elsewhere.
  "account_id": "43b0670039d0868f68ab4dd61e923ae3",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openstudent",
      // Placeholder for local development; `npx wrangler d1 create openstudent` gives the real id before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Login codes: per IP generous enough for a whole class behind a school NAT, per e-mail strict.
  "ratelimits": [
    { "name": "LOGIN_IP_LIMIT", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } },
    { "name": "LOGIN_USER_LIMIT", "namespace_id": "2002", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
